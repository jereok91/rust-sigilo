{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "basic_decrip",
  "version": "0.1.0",
  "identifier": "com.jeremy.basic-decrip",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "basic_decrip · AES-256",
        "width": 640,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
