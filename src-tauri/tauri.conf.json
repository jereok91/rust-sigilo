{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustSigilo",
  "mainBinaryName": "RustSigilo",
  "version": "0.1.0",
  "identifier": "com.jeremy.rustsigilo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RustSigilo · AES-256",
        "width": 640,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Cifrar y descifrar texto con AES-256",
    "longDescription": "Aplicación de escritorio para cifrar y descifrar texto con AES-256 (GCM/CBC) usando un secreto de 32 bytes en Base64.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
